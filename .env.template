# ============================================================
# Game Record Tool - 設定ファイル (.env)
# ============================================================
# このファイルは setup.bat によって data\.env にコピーされます。
# 実際に使うときは data\.env の方を編集してください。
# （この.env.template 自体は編集しなくて構いません）
#
# 書き方:
# - 「=」の右側に値を貼り付けてください。引用符（" や '）は不要です。
# - 行頭が # の行はコメントです。消しても構いません。
# - トークンはパスワードと同じです。他人に教えたり、
# SNS やチャットに貼ったりしないでください。
# ============================================================


# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN（必須）
# ------------------------------------------------------------
# Telegram の Bot（自動で通知を送るアカウント）のトークンです。
#
#
# 1. Telegram アプリで @BotFather を検索して開く
# 2. /newbot と送信し、Bot の表示名と username を決める
# 3. 最後に表示される長い文字列（例: 123456789:AA...）がトークンです
# 詳しい手順は SETUP_GUIDE.md の「4. BotFather での Bot 作成手順」を参照
#
#
# 下の行の「ここに貼り付け」の部分を、取得したトークンに置き換えてください。
TELEGRAM_BOT_TOKEN=ここに貼り付け


# ------------------------------------------------------------
# DISCOGS_TOKEN（必須）
# ------------------------------------------------------------
# Discogs（世界最大級のレコード・データベース）の
# 個人アクセストークンです。無料アカウントで発行できます。
# レコード情報の照合・確認に使います。
#
#
# 1. https://www.discogs.com/ にログインする（無ければ無料登録）
# 2. 右上のアイコン → Settings → Developers を開く
# 3. 「Generate new token」ボタンを押す
# 4. 表示された文字列がトークンです
# 詳しい手順は SETUP_GUIDE.md の「5. Discogs トークンの発行手順」を参照
#
#
# 下の行の「ここに貼り付け」の部分を、取得したトークンに置き換えてください。
DISCOGS_TOKEN=ここに貼り付け


# ------------------------------------------------------------
# 任意の API キー（Phase 3・未設定なら空欄のまま）
# ------------------------------------------------------------
# 以下は任意です。キーを取得した場合だけ、右側に貼り付けてください。
# 未設定の間、その API フェッチャーは無効のままで、本体の動作には
# 影響しません。取得していない場合は、行ごと削除せず空欄にします。
#
# EBAY_OAUTH_TOKEN: eBay Browse API の OAuth アプリトークン
# RAKUTEN_APP_ID: 楽天ウェブサービスのアプリケーション ID
# RAKUTEN_ACCESS_KEY: 楽天ウェブサービスのアクセスキー
# YAHOO_APP_ID: Yahoo!ショッピング API の Client ID（appid）
EBAY_OAUTH_TOKEN=
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
YAHOO_APP_ID=


# ------------------------------------------------------------
# ALLOWED_CHAT_ID（使用しません・互換のため残しています）
# ------------------------------------------------------------
# 許可リスト（Bot が応答してよい相手）は、このファイルではなく
# データベース側で管理されています。Bot に最初に /start を送った
# 人の chat_id が自動で登録される仕組みです。
# そのため、この行に値を書いても動作は変わりません。空欄のまま
# にしてください。
# （詳しくは SETUP_GUIDE.md の「6. Bot へ /start を送る手順」を参照）
#
# 登録をやり直したい場合（Telegram アカウントを作り直した等）は、
# SETUP_GUIDE.md の 6. にある「登録リセット」の手順を使ってください。
ALLOWED_CHAT_ID=


# ------------------------------------------------------------
# GRT_DATA_DIR（任意・通常は変更不要）
# ------------------------------------------------------------
# データ（データベース grt.db、ログ、この.env など）を置く場所です。
# 通常は変更不要です。空欄なら、このツールと同じフォルダ内の
# data フォルダが自動で使われます。
#
# 別の場所にデータを置きたい場合だけ、フォルダのパスを書いてください。
# 例: GRT_DATA_DIR=C:\Tools\game-record-tool\data
GRT_DATA_DIR=
